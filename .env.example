# URL of your Plex Media Server, reachable from where this app runs
PLEX_URL=http://192.168.1.10:32400
# Your Plex token: https://support.plex.tv/articles/204059436
PLEX_TOKEN=changeme
# Name of the movie library section in Plex
PLEX_LIBRARY=Movies
# Seconds to keep the library cached before reloading from Plex
CACHE_TTL=900
